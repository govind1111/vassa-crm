{
  "hosting": {
    "site": "vassa-crm",
    "public": "firebase_hosting/public",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/*.md",
      ".github/**",
      "backups/**",
      "preview/**",
      "tools/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.png",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
